#!/bin/sh
# pre-push hook: run the local CI mirror before anything is published.
#
# Enable once per clone:  git config core.hooksPath scripts/hooks
# Emergency bypass:       git push --no-verify
#
# Why this exists: two CI-only lint findings reached CI (PR #8, #10) because
# a bare local `golangci-lint run` uses a smaller linter set than the hub
# go-ci reusable. scripts/check.sh mirrors the CI invocation (its linter list
# is byte-identical; the deltas are named at its head), and this hook makes
# running it non-optional instead of a habit.
#
# Deliberately NOT skip-when-tools-absent: a silent skip recreates the exact
# hole this hook closes. If go/golangci-lint are missing or version-skewed,
# check.sh fails loudly and the push is refused — fix the tools or bypass
# consciously.
#
# Known gap (accepted): core.hooksPath is relative, so a WORKTREE whose
# checked-out branch predates scripts/hooks/ has no hook at all and pushes
# silently. Pushing old branches from worktrees is rare here; an absolute
# hooksPath would fix it but breaks the moment the clone moves.
#
# git exports GIT_DIR (and friends) to a hook. From the main checkout it is
# the relative ".git" and harmless; from a linked worktree it is ABSOLUTE,
# and every git the mirror's tests spawn in their own lab repos — and the
# furrow source-build wrapper's `git archive` — then acts on THIS repo
# instead ("remote origin already exists" from a contract test's lab,
# 2026-09-28). The mirror wants the plain environment a shell has.
top="$(git rev-parse --show-toplevel)"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
exec "$top/scripts/check.sh"
